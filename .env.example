PORT=8080
Name_database=srh
User_database=YOUR_USER
Pass_database=YOUR_PASSWORD
Host_database=127.0.0.1
Port_database=3306
Lang_database=mysql
SSL_database=false
SECRET=YOUR_JWT_SECRET
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET

# Entrada ate 08:00 + tolerancia (min) ainda conta como presente (15 = ate as 08:15)
TOLERANCIA_ENTRADA=15
#HORARIO_ENTRADA=08:00
#HORARIO_SAIDA=16:00

# --- Exemplo TiDB Cloud (produção) ---------------------------------------
# No Render, defina estas mesmas chaves em Environment (não apenas no .env local).
# O USERNAME do TiDB tem o prefixo do cluster — copie exactamente como aparece
# no painel do TiDB Cloud, incluindo o ponto.
#Name_database=sgfp
#User_database=3iCFazeCCn5edgy.root
#Pass_database=<PASSWORD_DO_TIDB>
#Host_database=gateway01.eu-central-1.prod.aws.tidbcloud.com
#Port_database=4000
#Lang_database=mysql
#SSL_database=true
#
# Também é aceite o formato URL (opcional, alternativo às variáveis acima):
#DATABASE_URL=mysql://3iCFazeCCn5edgy.root:<PASSWORD>@gateway01.eu-central-1.prod.aws.tidbcloud.com:4000/sgfp
#
# Coloque true para devolver o erro real da BD no JSON de erro (uso temporário):
#DEBUG_ERRORS=false
